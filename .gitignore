# ==============================================================================
# .gitignore - Nhóm 10 Web Engineering Portfolio
# Bỏ qua các file tạm, cấu hình IDE, hệ điều hành và file rác khi đẩy lên GitHub
# ==============================================================================

# 1. Hệ điều hành (Operating System Files)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 2. Trình soạn thảo & IDE (IDEs & Code Editors)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 3. Node.js & Package Managers (nếu có phát sinh sau này)
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 4. Thư mục Build / Cache / Tạm thời (Build Outputs & Caches)
dist/
build/
out/
.cache/
.parcel-cache/
tmp/
temp/
*.tmp

# 5. File nhật ký & Environment Variables (Logs & Secrets)
*.log
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 6. Các file cấu hình AI / Tooling tạm thời
.gemini/
voltagent/
